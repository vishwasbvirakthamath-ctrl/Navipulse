import os
import pickle
import numpy as np
import pandas as pd
from sklearn.ensemble import RandomForestRegressor
from sklearn.metrics import mean_squared_error
from utils import extract_rolling_features


def latlon_to_deltas(lat, lon):
    """
    Converts GPS Latitude/Longitude sequences into local metric displacements 
    (Delta North, Delta East in meters) using a flat-earth approximation.
    """
    R_earth = 6371000.0 * np.pi / 180.0  # meters per degree of latitude
    lat_val = lat.values
    lon_val = lon.values
    lat_rad = np.radians(lat_val)
    
    delta_lat = np.diff(lat_val, prepend=lat_val[0])
    delta_lon = np.diff(lon_val, prepend=lon_val[0])

    d_north = delta_lat * R_earth
    d_east = delta_lon * R_earth * np.cos(lat_rad)
    return d_north, d_east


def train_production_idr_model():
    print("=== Step 1: Initializing Advanced IDR Pipeline (Speed + Dead Reckoning) ===")

    script_dir = os.path.dirname(os.path.abspath(__file__))
    data_filename = os.path.join(script_dir, "cleaned_data.csv.txt")
    
    if not os.path.exists(data_filename):
        raise FileNotFoundError(
            f"Dataset not found at: {data_filename}. "
            f"Files currently in that folder: {os.listdir(script_dir)}"
        )

    # Added encoding='latin-1' to fix UnicodeDecodeError on Windows special characters
    df = pd.read_csv(data_filename, encoding='latin-1')
    print(f"Successfully loaded '{os.path.basename(data_filename)}' with shape: {df.shape}")

    # Clean whitespace from column names to prevent mapping mismatches
    df.columns = df.columns.str.strip()

    column_mapping = {
        'ACCELEROMETER X (m/s²)': 'accel_x',
        'ACCELEROMETER Y (m/s²)': 'accel_y',
        'ACCELEROMETER Z (m/s²)': 'accel_z',
        'GYROSCOPE Yaw (rad/s)': 'gyro_x',
        'GYROSCOPE Pitch (rad/s)': 'gyro_y',
        'GYROSCOPE Roll (rad/s)': 'gyro_z',
        'GPS LATITUDE (degrees)': 'lat',
        'GPS LONGITUDE (degrees)': 'lon',
        'GPS SPEED (Kmh)': 'speed',
        'GPS ACCURACY (m)': 'gps_accuracy',
        'TIME SINCE START (ms)': 'timestamp',
    }
    
    for col in column_mapping.keys():
        if col not in df.columns:
            raise ValueError(f"Missing expected dataset column: {col}")
            
    df = df.rename(columns=column_mapping)

    # Sort chronologically first
    df = df.sort_values(by='timestamp').reset_index(drop=True)

    # Drop duplicate timestamps to prevent division-by-zero math errors
    dupe_count = df['timestamp'].duplicated().sum()
    if dupe_count:
        print(f"Dropping {dupe_count} duplicate-timestamp rows.")
        df = df.drop_duplicates(subset='timestamp', keep='first').reset_index(drop=True)

    print("Computing ground truth targets (Delta North + Delta East)...")
    df['delta_north'], df['delta_east'] = latlon_to_deltas(df['lat'], df['lon'])

    # Mask position deltas where GPS accuracy is poor (> 5.0 meters)
    accurate = df['gps_accuracy'] <= 5.0
    row_and_prev_accurate = accurate & accurate.shift(1, fill_value=False)
    df.loc[~row_and_prev_accurate, ['delta_north', 'delta_east']] = np.nan
    print(f"{int(row_and_prev_accurate.sum())} / {len(df)} rows have trustworthy position deltas.")

    # Run feature engineering via utils.py
    processed_df = extract_rolling_features(df, window_size=5)

    exclude_cols = {
        'timestamp', 'lat', 'lon', 'delta_north', 'delta_east',
        'gps_accuracy', 'speed', 'accel_x', 'accel_y',
    }
    feature_columns = [c for c in processed_df.columns if c not in exclude_cols]

    # Force all feature columns to be numeric, converting text/rogue strings to NaN
    for col in feature_columns:
        processed_df[col] = pd.to_numeric(processed_df[col], errors='coerce')

    X = processed_df[feature_columns]
    y = processed_df[['speed', 'delta_north', 'delta_east']]

    # FIX: Instead of dropping rows where *any* rolling feature is a NaN,
    # we only drop rows where the target values (speed, delta_north, delta_east) are missing,
    # and fill missing feature NaNs safely with 0 (standard practice for rolling window edge effects).
    y_valid_idx = ~y.isna().any(axis=1)
    X = X[y_valid_idx]
    y = y[y_valid_idx]
    
    # Fill remaining feature NaNs (from initial rolling window frames) with 0
    X = X.fillna(0)

    print(f"Total features engineered for training: {len(feature_columns)}")
    print(f"Final clean dataset samples ready for training: {len(X)}")

    if len(X) == 0:
        raise ValueError("Dataset is still empty after cleaning! Check your rolling window or filters.")

    # Chronological split (80/20) to prevent time-series data leakage
    train_size = int(0.8 * len(X))
    X_train, X_test = X.iloc[:train_size], X.iloc[train_size:]
    y_train, y_test = y.iloc[:train_size], y.iloc[train_size:]

    print("=== Step 2: Training Multi-Output Regressor: Speed + Position Deltas ===")
    model = RandomForestRegressor(
        n_estimators=150,
        max_depth=12,
        min_samples_split=10,
        random_state=42,
        n_jobs=-1,
    )
    model.fit(X_train, y_train)

    predictions = model.predict(X_test)
    rmse_per_target = np.sqrt(((predictions - y_test.values) ** 2).mean(axis=0))
    print("Per-target Test RMSE:")
    for name, val in zip(y.columns, rmse_per_target):
        print(f"  {name}: {val:.4f}")

    model_filename = 'idr_comprehensive_model.pkl'
    with open(model_filename, 'wb') as file:
        pickle.dump({'model': model, 'features': feature_columns}, file)
    print(f"=== Step 3: Artifact Saved Successfully as '{model_filename}' ===")


if __name__ == "__main__":
    train_production_idr_model()
